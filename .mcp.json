{
  "mcpServers": {
    "fridge-kb": {
      "type": "stdio",
      "command": "node",
      "args": ["${CLAUDE_PROJECT_DIR:-.}/mcp-server/dist/index.js"],
      "env": {
        "VAULT_PATH": "${VAULT_PATH:-../whats-in-the-fridge-vault}",
        "APP_PATH": "${CLAUDE_PROJECT_DIR:-.}",
        "APP_REPO_NAME": "whats-in-the-fridge"
      }
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PAT}",
        "X-MCP-Toolsets": "repos,pull_requests",
        "X-MCP-Readonly": "true"
      }
    }
  }
}
